{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "on tuesday"
  ],
  "packageRules": [
    {
      "description": "Platform services: Helm chart versions from Chart.yaml and workload image tags from values.yaml",
      "matchFileNames": [
        "services/helm/**"
      ],
      "matchManagers": [
        "helmv3",
        "helm-values"
      ]
    }
  ]
}
